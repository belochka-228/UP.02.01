<Page x:Class="SalesToys.Pages.RegisterPag"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SalesToys.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPag">

    <Grid>
        <Border CornerRadius="10" Background="AliceBlue" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Регистрация" FontWeight="Bold" Margin="0,10"/>
                <TextBlock Text="Введите свое ФИО"/>
                <TextBox x:Name="txtFIO" Width="200"/>
                <TextBlock Text="Введите логин"/>
                <TextBox x:Name="txtLogin" Width="200"/>
                <TextBlock Text="Введите пароль"/>
                <PasswordBox x:Name="txtPassword" Width="200"/>
                <TextBlock Text="Повторите пароль"/>
                <PasswordBox x:Name="txtPassword2" Width="200"/>

                <Button Content="Зарегистрироваться" Click="ButtonReg_Click" Margin="0,10"/>
                <Button Content="Назад" Click="ButtonBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
