<Page x:Class="SalesToys.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SalesToys.Pages"
      mc:Ignorable="d" 
      FontFamily="{StaticResource FontArial}"
      Background="{StaticResource BrushMainBackground}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid Margin="10">
        <Border CornerRadius="10" Background="{StaticResource BrushSecondaryBackground}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Авторизация" FontWeight="Bold" Margin="0,10"/>
                <TextBlock Text="Введите логин"/>
                <TextBox x:Name="txtLogin" Width="200"/>
                <TextBlock Text="Введите пароль"/>
                <PasswordBox x:Name="txtPassword" Width="200"/>

                <Button Content="Войти" Click="ButtonAuth_Click" Margin="0,10"/>
                <Button Content="Посмотреть товары" Click="ButtonTovar_Click"/>

                <TextBlock Margin="0,10">
                        Нет аккаунта? 
                    <Hyperlink Click="RegisterLink_Click" Foreground="{StaticResource BrushAccent}">
                        Зарегистрироваться
                    </Hyperlink>    
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Page>
