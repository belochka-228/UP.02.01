<Page x:Class="SalesToys.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SalesToys.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrdersPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox Grid.Row="0" x:Name="lstOrders" SelectionChanged="lstOrders_SelectionChanged"  d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
                                <TextBlock Text="{Binding Artikul, StringFormat='Артикул заказа: {0}'}"/>
                                <TextBlock Text="{Binding Status.StatusOrder, StringFormat='Статус заказа: {0}'}"/>
                                <TextBlock Text="{Binding PVZ.Address, StringFormat='Адрес: {0}'}"/>
                                <TextBlock Text="{Binding OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeliveryDate, StringFormat= Дата доставки: {0}}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Row="2" Content="Назад" Margin="10" Width="100" Click="BtnBack_Click" HorizontalAlignment="Left"/>
        <StackPanel x:Name="TovarPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Visibility="Collapsed">
            <Button Content="Добавить заказ" Width="200" Click="ButtonAddOrder_Click"/>
            <Button Content="Удалить заказ" Width="200" Click="ButtonDeleteOrder_Click"/>
        </StackPanel>
    </Grid>
</Page>
