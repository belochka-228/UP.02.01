<Page x:Class="SalesToys.Pages.GatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SalesToys.Pages"
      mc:Ignorable="d" 
      Background="{StaticResource BrushMainBackground}"
      FontFamily="{StaticResource FontArial}"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GatalogPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel x:Name="FilterPanel"  Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Поиск: "/>
            <TextBox x:Name="txtSource" Width="150" TextChanged="txtSource_TextChanged"/>
            <TextBlock Text="Отсортировать по: " Margin="5,0"/>
            <ComboBox x:Name="cmbPrice" Width="Auto" SelectionChanged="cmbPrice_SelectionChanged">
                <ComboBoxItem>Цене (Возрастание)</ComboBoxItem>
                <ComboBoxItem>Цене (Убывание)</ComboBoxItem>
                <ComboBoxItem>Количеству на складе (Возрастание)</ComboBoxItem>
                <ComboBoxItem>Количеству на складе (Убывание)</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Отфильтровать по: " Margin="5,0" />
            <ComboBox x:Name="cmbSupplier" Width="Auto" SelectionChanged="cmbSupplier_SelectionChanged"/>
        </StackPanel>

        <ListBox Grid.Row="1" x:Name="lstTovar" d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Padding="5" Loaded="ItemBorder_Loaded">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" >
                                <Image Source="{Binding ImagePath}" Width="300" Height="200" Stretch="Uniform"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Category.CategoryTovara}"/>
                                <TextBlock Text=" | "/>
                                <TextBlock Text="{Binding Name}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description, StringFormat=Описание товара: {0}}"/>
                                <TextBlock Text="{Binding Suppliers.Supplier, StringFormat=Поставщик: {0}}"/>
                                <TextBlock Text="{Binding Manufacturers.Manufacturer, StringFormat=Производитель: {0}}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Price, StringFormat=Цена: {0}}" Foreground="Red"
                                               TextDecorations="Strikethrough"
                                               Loaded="OldPrice_Loaded"/>
                                    <TextBlock Foreground="Black"
                                               Margin="10,0,0,0"
                                               Loaded="FinalPrice_Loaded"/>
                                </StackPanel>
                            <TextBlock Text="{Binding Unit, StringFormat=Единица измерения: {0}}"/>
                            <TextBlock x:Name="txtColvo" Text="{Binding Quantity, StringFormat=Количество на складе: {0} }"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Discount}"/>
                        </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="TovarPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10" Visibility="Collapsed">
            <Button Content="Добавить товар" Width="200" Click="ButtonAddProduct_Click"/>
            <Button Content="Удалить товар" Width="200" Click="ButtonDeleteProduct_Click"/>
        </StackPanel>
    </Grid>
</Page>
