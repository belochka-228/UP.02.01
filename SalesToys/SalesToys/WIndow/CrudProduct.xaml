<Window x:Class="SalesToys.WIndow.CrudProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SalesToys.WIndow"
        mc:Ignorable="d"
        Background="{StaticResource BrushMainBackground}"
        Title="CrudProduct" Height="600" Width="800">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="500">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650">
                <StackPanel>
                    <StackPanel x:Name="spID" Orientation="Vertical">
                        <TextBlock Text="ID товара"/>
                        <TextBox x:Name="txtID" IsReadOnly="True"/>
                    </StackPanel>

                    <TextBlock Text="Артикул товара"/>
                    <TextBox x:Name="txtArtikul"/>
                    
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Фото товара"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="txtImage" Height="20" Width="300" Margin="0,0,5,0"/>
                            <Button Content="Загрузить фото" Height="20" Click="BtnDowlound_Click" Background="{StaticResource BrushAccent}"/>
                        </StackPanel>
                        <Image x:Name="ImgPreview" Height="150" Width="150" Stretch="Uniform" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Наименование товара"/>
                    <TextBox x:Name="txtName"/>

                    <TextBlock Text="Категория товара"/>
                    <ComboBox x:Name="cmbCategory" SelectedValuePath="ID"  DisplayMemberPath="CategoryTovara"/>

                    <TextBlock Text="Описание товара"/>
                    <TextBox x:Name="txtDescription" TextWrapping="Wrap"/>

                    <TextBlock Text="Производитель"/>
                    <ComboBox x:Name="cmbManufacturer" SelectedValuePath="ID" DisplayMemberPath="Manufacturer"/>

                    <TextBlock Text="Поставщик"/>
                    <ComboBox x:Name="cmbSupplier" SelectedValuePath="ID" DisplayMemberPath="Supplier"/>

                    <TextBlock Text="Цена"/>
                    <TextBox x:Name="txtPrice"/>

                    <TextBlock Text="Единица измерения"/>
                    <TextBox x:Name="txtUnit"/>

                    <TextBlock Text="Количество на складе" Margin="0,5"/>
                    <TextBox x:Name="txtQuantity"/>
                    
                    <TextBlock Text="Действующая скидка" Margin="0,5"/>
                    <TextBox x:Name="txtDiscount"/>

                    <Button Content="Сохранить" Click="BtnSave_Click" Margin="0,20,0,5"/>
                    <Button Content="Назад без сохранения" Click="BtnBack_Click"  Background="{StaticResource BrushAccent}" BorderThickness="1"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
