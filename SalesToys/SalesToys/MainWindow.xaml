<Window x:Class="SalesToys.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SalesToys"
        mc:Ignorable="d"
        Icon="/Image/icon.ico"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" >
                    <TextBlock x:Name="txtFIO" HorizontalAlignment="Left" FontSize="18" Margin="5" VerticalAlignment="Center"/>
                </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" Width="100" x:Name="btn_Back" Click="dtn_Back_Click" HorizontalAlignment="Right" Margin="5"/>
                <Button x:Name="BtnButton" Content="Выйти" Click="BtnBackLogin_Click" Width="100" Margin="5" Visibility="Visible"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="txtTitle" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
